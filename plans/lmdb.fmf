provision:
    how: virtual
    hardware:
        memory: '>= 4 GiB'
        disk:
            - size: '>= 20 GiB'

prepare:
    - name: Install 389-ds-base packages
      how: install
      package:
          - 389-ds-base
          - 389-ds-base-libs
          - python3-lib389

    - name: Install debuginfo packages
      how: shell
      script: dnf install -y 389-ds-base-debuginfo 389-ds-base-libs-debuginfo 389-ds-base-debugsource

    - name: Install test dependencies
      how: shell
      script: |
          dnf install -y --skip-unavailable \
              python3-pytest python3-ldap openssl nss-tools openldap-clients \
              krb5-server krb5-workstation expect sssd-tools gcc \
              389-ds-base-devel json-c-devel nspr-devel nss-devel

    - name: Configure test environment
      how: shell
      script: |
          HOSTNAME=$(hostname)
          IP=$(hostname -I | awk '{print $1}')
          grep -q "$HOSTNAME" /etc/hosts || echo "$IP $HOSTNAME" >> /etc/hosts
          mkdir -p /var/tmp/cores
          chmod 777 /var/tmp/cores
          echo '/var/tmp/cores/core.%e.%P' > /proc/sys/kernel/core_pattern
          systemctl start dbus.service

environment:
    NSSLAPD_DB_LIB: mdb
    GSSAPI_ACK: 1

execute:
    how: tmt

report:
    how: junit

/acl:
    summary: Acl (LMDB)
    discover:
        how: shell
        tests:
            - name: acl
              test: ./dirsrvtests/run-suite.sh acl
              path: /
              duration: 90m

/attr_encryption:
    summary: Attr Encryption (LMDB)
    discover:
